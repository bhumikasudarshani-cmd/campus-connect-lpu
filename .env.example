# ==========================================================
# Campus Connect LPU – Environment Variables
# Supports both Next.js and Vite / Supabase naming
# ==========================================================

# 1. Supabase Project Credentials (Obtain from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend only - NEVER expose this in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Community WhatsApp / Telegram Group Link
NEXT_PUBLIC_COMMUNITY_INVITE_URL=https://chat.whatsapp.com/invite/campus-connect-lpu-2026

# 4. JWT & Session Secret
JWT_SECRET=generate_a_random_32_character_secret_here

# 5. Google Drive Integration (Direct Browser Resumable Uploads)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=277645296967-m8dn80c6o3lggtubj6kck3esrd1kbj9d.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=277645296967-m8dn80c6o3lggtubj6kck3esrd1kbj9d.apps.googleusercontent.com
# Optional: Set a specific folder ID, otherwise a dedicated 'Campus Connect Study Materials' folder is automatically used
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_ID=
VITE_GOOGLE_DRIVE_FOLDER_ID=
